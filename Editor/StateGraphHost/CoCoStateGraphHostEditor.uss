/* CoCoFlow StateGraphHost 模块补充样式（ccflow- BEM，D10）。
 * Token 基准与 Editor/Common/CoCoEditorCommon.uss 同源；本文件只承载
 * Host Inspector / Runtime Debugger 专属结构（键值行/指标/链行/Trace 行）。
 * 深色（Pro）主题唯一支持形态（继承 P02 D15）。 */

/* ── 键值行（快照/状态投影） ─────────────────────── */

.ccflow-host-kv-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 1px;
    margin-bottom: 1px;
}

.ccflow-host-kv-row__key {
    flex-shrink: 0;
    min-width: 130px;
    margin-right: 8px;
    opacity: 0.65;
}

.ccflow-host-kv-row__value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-style: bold;
}

/* ── 指标条（Debugger 顶部计数） ─────────────────── */

.ccflow-host-metrics {
    flex-direction: row;
    margin-bottom: 8px;
}

.ccflow-host-metric {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-left-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.3);
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.3);
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.3);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.3);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(128, 128, 128, 0.055);
    margin-right: 6px;
    align-items: center;
}

.ccflow-host-metric__value {
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.ccflow-host-metric__label {
    font-size: 10px;
    opacity: 0.65;
    white-space: normal;
}

/* ── Restore 链预览行 ────────────────────────────── */

.ccflow-host-chain-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 6px;
}

.ccflow-host-chain-row__arrow {
    flex-shrink: 0;
    margin-right: 6px;
    opacity: 0.65;
}

.ccflow-host-chain-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* ── Trace 列表行 ────────────────────────────────── */

.ccflow-host-trace-group {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 3px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.16);
}

.ccflow-host-trace-row {
    white-space: normal;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    opacity: 0.92;
}

/* ── 绑定列表行 ──────────────────────────────────── */

.ccflow-host-binding-row {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-left-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.16);
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.16);
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.16);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.16);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ccflow-host-binding-row__head {
    flex-direction: row;
    align-items: center;
}

.ccflow-host-binding-row__field {
    flex-grow: 1;
    flex-shrink: 1;
}

.ccflow-host-binding-row__remove {
    flex-shrink: 0;
    margin-left: 4px;
}

.ccflow-host-binding-row__desc {
    white-space: normal;
    opacity: 0.65;
    margin-top: 2px;
}

/* ── 小节间距 ────────────────────────────────────── */

.ccflow-host-subsection {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}
