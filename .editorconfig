root = true

# 针对所有文件的基础规范
[*]
indent_style = space
indent_size = 4

end_of_line = lf

insert_final_newline = true

trim_trailing_whitespace = true

# 专门针对 C# 脚本的规范
[*.cs]

charset = utf-8-bom

# These folders group implementation files by responsibility. Their public
# namespaces predate the asmdef layout and are used by external C# and Unity assets.
[Runtime/{StateGraph/Contracts/**/*,StateGraph/StateFlow/*,StateGraphHost/Assets/*,StateGraphHost/Unity/*}.cs]
resharper_check_namespace_highlighting = hint

[Editor/{Core/Common/*,StateGraphHost/CoCoContextProviderDrawer}.cs]
resharper_check_namespace_highlighting = hint
